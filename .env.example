# SkillBridge AI Environment Variables Configuration
PORT=3000
# Relative paths are resolved from the backend directory. In production, set
# this to a file on a persistent Render disk (for example /var/data/skillmap.db).
DB_FILE_PATH=./skillmap.db
JWT_SECRET=skillbridge-enterprise-secret-key-2026
FRONTEND_URL=https://ekinterview.vercel.app
FILE_STORAGE_PATH=./uploads
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_MS=15000
NODE_ENV=production
